{
    "compilerOptions": {
        "target": "ES2022",// Js version (syntax)
        "module": "es2022",// use import or require
        "moduleResolution": "node", // how modules are resolved (Search strategy)
        "noImplicitAny": false,
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "allowSyntheticDefaultImports": true,
        "rootDir": "./src",
        "allowJs": true
    },
    "include": [
        "src"
    ]
}