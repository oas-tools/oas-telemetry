{
  "name": "@oas-tools/oas-telemetry",
  "version": "0.8.0-alpha.2",
  "description": "Automatically collects and stores telemetry data in memory using OpenTelemetry. Just import the Express middleware to access it through the built-in REST API or web UI—no extra setup required.",
  "author": "Manuel Otero",
  "contributors": [
    "Alejandro Santisteban",
    "Pablo Fernandez"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "env OASTLM_BOOT_ENV=development tsx watch test/e2e/servers/otTestServer.ts",
    "esm": "echo 'Remember to execute: \"npm run build\"' && node test/e2e/servers/otTestServer.mjs",
    "cjs": "echo 'Remember to execute: \"npm run build\"' && node test/e2e/servers/otTestServer.cjs",
    "build": "npm run clean && npm run build:types && npm run build:esm && npm run build:cjs && npm run copy:spec && npm run copy:ui",
    "clean": "rm -rf dist",
    "build:types": "tsc --declaration --emitDeclarationOnly --declarationDir ./dist/types",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && npm run postbuild:cjs",
    "postbuild:cjs": "find dist/cjs -name '*.js' -exec bash -c 'mv \"$1\" \"${1%.js}.cjs\"' _ {} \\; && find dist/cjs -name '*.cjs' -exec sed -i \"s/\\.js'/\\.cjs'/g\" {} \\; && find dist/cjs -name '*.cjs' -exec sed -i 's/\\.js\"/\\.cjs\"/g' {} \\; && find dist/cjs -name '*.cjs' -exec sed -i 's/import\\.meta\\.url/__filename/g' {} \\;",
    "copy:spec": "mkdir -p dist/esm/docs dist/cjs/docs && cp src/docs/openapi.yaml dist/esm/docs/ && cp src/docs/openapi.yaml dist/cjs/docs/",
    "copy:ui": "mkdir -p dist/ui && cp -r ../ui/dist/* dist/ui/ 2>/dev/null || true",
    "test": "vitest --run",
    "test:watch": "vitest",
    "lint": "eslint --ext .ts . --fix"
  },
  "files": [
    ".env.example",
    "NOTICE",
    "dist"
  ],
  "exports": {
    ".": {
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.cjs"
      },
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    }
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@opentelemetry/api-logs": "^0.214.0",
    "@opentelemetry/core": "^2.6.1",
    "@opentelemetry/instrumentation": "^0.214.0",
    "@opentelemetry/instrumentation-http": "^0.214.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.27.0",
    "@opentelemetry/resources": "^2.6.1",
    "@opentelemetry/sdk-logs": "^0.214.0",
    "@opentelemetry/sdk-metrics": "^2.6.1",
    "@opentelemetry/sdk-node": "^0.214.0",
    "@opentelemetry/sdk-trace-base": "^2.6.1",
    "@opentelemetry/sdk-trace-node": "^2.6.1",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@seald-io/nedb": "^4.1.2",
    "axios": "^1.15.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "dynamic-installer": "^2.0.0",
    "express": "^5.2.1",
    "globals": "^17.4.0",
    "import-from-string": "^0.0.5",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.3",
    "lodash.merge": "^4.6.2",
    "minisearch": "^7.2.0",
    "openai": "^6.34.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@opentelemetry/api": "^1.9.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash.merge": "^4.6.9",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.1.3"
  }
}
