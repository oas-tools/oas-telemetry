
# Backend port for OASTLM telemetry API (development only)
# In production this is calculated automatically from the pathname
# In development, backend is assumed to be on the same host as frontend but on this port
# Default: 3000
VITE_OASTLM_BACKEND_PORT=3000

# Base URL path for OASTLM endpoints (must match backend baseUrl config)
# In production this is calculated automatically from the pathname
# In development, this is combined with the backend host
# Examples:
#   /telemetry (default)
#   /dev/telemetry
#   /api/v1/telemetry
VITE_OASTLM_BASE_URL=/telemetry